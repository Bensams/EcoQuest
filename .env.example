# Copy to .env for local development. Placeholder values only - never commit real secrets.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=ecoquest
POSTGRES_PASSWORD=ecoquest_dev_password
POSTGRES_DB=ecoquest
POSTGRES_PORT=5432

# --- API ---
# development or test only permits scripts/reset-demo.ps1 and scripts/demo.ps1.
APP_ENV=development
DATABASE_URL=postgres://ecoquest:ecoquest_dev_password@localhost:5432/ecoquest
DATABASE_MAX_CONNECTIONS=10
API_BIND_ADDR=0.0.0.0:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Public origin of the web client. Used to build links handed to users, such as
# administrator-issued password resets. Defaults to the first CORS origin.
WEB_BASE_URL=http://localhost:5173
RUST_LOG=info,ecoquest_api=debug
LOG_JSON=false

# --- Auth ---
# Minimum 32 characters. Generate per environment; never reuse this placeholder.
JWT_SECRET=dev_only_change_me_0123456789abcdef
# 8 hours: long enough for a working day, so the client rarely needs to rotate
# the refresh token. Access tokens are stateless and cannot be revoked, so a
# suspension or role change only takes full effect once this expires.
ACCESS_TOKEN_TTL_SECS=28800
REFRESH_TOKEN_TTL_SECS=2592000
# Must be true wherever the API is served over HTTPS.
COOKIES_SECURE=false
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECS=60

# --- CLI ---
ECOQUEST_API_URL=http://localhost:8080
SEED_ADMIN_EMAIL=admin@ecoquest.test
SEED_ADMIN_USERNAME=eco_admin
SEED_PASSWORD=ChangeMe-Local-1234

# --- Web client (Vite) ---
VITE_API_URL=http://localhost:8080
